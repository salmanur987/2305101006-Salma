<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Kotak header berwarna primary -->
    <style name="KonteninHeader">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/primary</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Teks di atas header -->
    <style name="KonteninTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KonteninSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:alpha">0.85</item>
    </style>

    <!-- Label di atas setiap gambar grid -->
    <style name="KonteninGridLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/scrim_label</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Teks umum halaman biasa -->
    <style name="KonteninHeading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KonteninBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Tombol -->
    <style name="KonteninButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>