<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Teks -->
    <style name="Kontenin.Text.Header" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Kontenin.Text.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/kontenin_text_secondary</item>
    </style>

    <style name="Kontenin.Text.ItemLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Gambar dengan sudut membulat 12dp -->
    <style name="ShapeAppearance.Kontenin.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Kontenin.GridImage" parent="">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Kontenin.Rounded</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

</resources>